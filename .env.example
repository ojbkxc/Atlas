# 复制为 .env；真实凭据不得提交。沿用 legacy-suite 键名。
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_PROD_USERNAME=
DEMO_PROD_PASSWORD=
# DEMO_PWD_DEMO_USER=
DEMO_URL_SIT=
DEMO_URL_UAT_EU=
DEMO_URL_UAT_AMER=
DEMO_URL_UAT_HK=
DEMO_URL_PROD_EU=
DEMO_URL_PROD_AMER=
DEMO_URL_PROD_HK=
# 可选：插件外部资产路径（支持相对 Atlas 根目录或绝对路径）
# ATLAS_LEGACY_PROJECT=../legacy-suite
# ATLAS_DEMO_API_PROJECT=../legacy-api
# ATLAS_RUNLOG_HOME=../runlog
# ATLAS_TOOLBOX_PROJECT=../toolbox
# ATLAS_BROWSER_CHANNEL=chrome
# 可选：私有知识目录（内部坑点/组件/BU坐标写这里，包内虚构默认自动回退，仓库零污染）
# ATLAS_KNOWLEDGE_DIR=

# 可选：对接真实旧项目时的映射（默认值即仓库自带的虚构 demo，不改也能跑离线）
# 键前缀整体切换：URL 与凭据键一起换
# ATLAS_ENV_PREFIX=ISERVICE_
# ATLAS_LEGACY_WEB=iservice
# ATLAS_LEGACY_TEST_NODE=testcases/sit_bu_a_regression/test_sit_bu_a_regression.py
# ATLAS_DEMO_API_FILE=ics_api.py
# ATLAS_DEMO_API_CLASS=IcsApi
# ATLAS_DEMO_API_SPEC=ics_endpoints.json
# 纯 UI 旧项目（如 iservice）没有接口客户端：指向最小协议垫片即可过 attach_demo 预检——
#   ATLAS_DEMO_API_PROJECT=<Atlas>/knowledge/ui-auto-test/shim-api
#   ATLAS_DEMO_API_FILE=ics_api_shim.py
#   ATLAS_DEMO_API_CLASS=IcsApiShim      （只需实现 _load_spec；UI 用例不调业务 API）
# ATLAS_APP_HEADER_KEY=isc-app
# ATLAS_APP_HEADER_VALUE=iservice

# 可选：真实业务会话默认值覆盖（仓库 session.json 为虚构值，真实 atlas run 必须覆盖）
# 密码仍只走上面的 DEMO_*/ISERVICE_* 键，这里只是账号名/OU/division/语言
# ATLAS_SESSION_ACCOUNT=
# ATLAS_SESSION_OU=
# ATLAS_SESSION_DIVISION=
# ATLAS_SESSION_LANGUAGE=English US
